<?xml version="1.0" encoding="UTF-8"?>
<templates id="pos_to_hotel_folio_templates" xml:space="preserve">
    <!-- Restore default Payment button everywhere. Add separate Send to Folio button only for restaurant action pad. -->
    <t t-name="pos_to_hotel_folio.ActionpadWidgetRestaurant" t-inherit="pos_restaurant.ActionpadWidget" t-inherit-mode="extension">
        <!-- Keep Payment button as-is; insert a secondary Send to Folio button right after it -->
        <xpath expr="//div[hasclass('validation')]//button[hasclass('pay-order-button')]" position="after">
            <button t-if="!currentOrder.is_empty()"
                t-on-click="() =&gt; pos.sendCurrentOrderToFolio()"
                class="button btn btn-light btn-lg py-3 d-flex align-items-center justify-content-center flex-fill"
            >
                Send to Folio
            </button>
        </xpath>
    </t>
</templates>