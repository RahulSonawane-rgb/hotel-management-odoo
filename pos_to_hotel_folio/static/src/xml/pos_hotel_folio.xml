<?xml version="1.0" encoding="UTF-8"?>
<templates id="pos_to_hotel_folio_templates" xml:space="preserve">
    <!-- Add 'Send to Folio' to the Actions modal (ControlButtons) -->
    <t t-name="pos_to_hotel_folio.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button class="btn btn-secondary btn-lg py-5"
                t-if="!currentOrder?.is_empty()"
                t-on-click="() =&gt; this.pos.sendCurrentOrderToFolio()"
            >
                <i class="fa fa-bed me-1" role="img" aria-label="Send to Folio" title="Send to Folio"/>
                Send to Folio
            </button>
        </xpath>
    </t>
</templates>