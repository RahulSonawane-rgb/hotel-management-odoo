<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Extend invoice report to show Beneficiary just below Salesperson -->
    <template id="report_invoice_document_inherit_beneficiary" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@name='salesperson']" position="after">
            <t t-if="(('beneficiary_id' in o._fields) and o.beneficiary_id) or (('beneficiary_ids' in o._fields) and o.beneficiary_ids)">
                <div class="row" name="beneficiary">
                    <div class="col-auto">
                        <strong>Beneficiary</strong>
                    </div>
                    <div class="col-auto">
                        <t t-if="('beneficiary_id' in o._fields) and o.beneficiary_id">
                            <span t-esc="o.beneficiary_id.display_name"/>
                        </t>
                        <t t-else="">
                            <t t-if="('beneficiary_ids' in o._fields) and o.beneficiary_ids">
                                <t t-foreach="o.beneficiary_ids" t-as="b">
                                    <span t-esc="b.display_name"/>
                                    <t t-if="not loop.last">, </t>
                                </t>
                            </t>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>

